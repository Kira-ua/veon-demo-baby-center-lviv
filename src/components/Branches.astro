---
import { Image } from "astro:assets";
import Section from "./Section.astro";
import Icon from "./Icon.astro";
import { branches, telegram, instagram } from "../data/client";
import centr from "../assets/branch-centr.jpg";
import chornovola from "../assets/branch-chornovola.jpg";
const photos = { centr, chornovola } as const;
const alts = { centr: "Ігрова кімната філії «Центр»: полиці з розвивальними іграшками і дитячі столи", chornovola: "Хол філії «Чорновола» з рецепцією і диваном для батьків" } as const;
---
<Section id="branches" rec="R-002,R-003" class="branches section" tone="accent">
  <div class="container">
    <div class="branches__head">
      <h2>Дві філії: «Центр» і «Чорновола»</h2>
      <p class="lead">Оберіть ближчу і запишіться на безкоштовне заняття.</p>
    </div>
    <div class="branches__grid">
      {branches.map((b) => (
        <article class="branch" aria-labelledby={`b-${b.id}`}>
          <h3 id={`b-${b.id}`}>Філія «{b.name}»</h3>
          <p class="branch__street">{b.street}</p>
          <div class="branch__acts">
            <a class="btn" href={b.phone}><Icon name="phone" /><span class="visually-hidden">Телефон </span><span class="num">{b.phoneLabel}</span></a>
            {b.viber && <a class="btn btn--quiet" href={b.viber}><Icon name="viber" />Viber</a>}
          </div>
          <p class="branch__links">
            <a class="link" href={b.map} rel="noopener"><Icon name="map" />Маршрут на карті</a>
            <a class="link" href={`mailto:${b.email}`}><Icon name="mail" />{b.email}</a>
          </p>
          <figure class="branch__photo">
            <Image src={photos[b.id]} alt={alts[b.id]} widths={[366]} sizes="(min-width: 64rem) 366px, 100vw" loading="lazy" decoding="async" />
          </figure>
        </article>
      ))}
    </div>
    <div class="branches__common">
      <p>Пишіть нам у месенджери або дивіться життя центру в Instagram.</p>
      <div class="actions">
        <a class="btn btn--quiet" href={telegram.href} rel="noopener"><Icon name="telegram" />Telegram {telegram.label}</a>
        <a class="btn btn--quiet" href={instagram.href} rel="noopener"><Icon name="instagram" />Instagram</a>
      </div>
    </div>
  </div>
</Section>

<style>
  .branches__head { display: grid; gap: var(--space-md); margin-bottom: var(--space-2xl); }
  .branches__grid { display: grid; gap: var(--space-3xl); }
  .branch { display: grid; gap: var(--space-md); align-content: start; padding-top: var(--space-lg); border-top: 2px solid var(--color-text); }
  .branch__street { font-family: var(--font-display); font-weight: 800; font-size: var(--text-section); line-height: 1.05; letter-spacing: -0.02em; }
  .branch__acts { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-top: var(--space-xs); }
  .branch__links { display: grid; gap: var(--space-2xs); }
  .branch__links a { display: inline-flex; align-items: center; gap: var(--space-xs); min-height: var(--tap); overflow-wrap: anywhere; }
  .branch__links :global(svg) { width: 1.25rem; height: 1.25rem; flex-shrink: 0; }
  .branch__photo { margin: var(--space-md) 0 0; max-width: 366px; }
  .branch__photo :global(img) { width: 100%; height: auto; aspect-ratio: 61 / 30; object-fit: cover; border-radius: var(--radius-photo); outline: 1px solid color-mix(in srgb, var(--color-text) 8%, transparent); outline-offset: -1px; }
  .branches__common { display: grid; gap: var(--space-md); margin-top: var(--space-3xl); padding-top: var(--space-lg); border-top: 1px solid var(--color-rule); }

  @media (min-width: 64rem) {
    .branches__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gap); column-gap: calc(var(--gap) * 2); }
    .branches__common { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gap); align-items: center; }
    .branches__common p { grid-column: 1 / 7; font-size: var(--text-lead); }
    .branches__common .actions { grid-column: 7 / 13; justify-content: flex-end; }
  }
</style>
