---
// Phones only: «Подзвонити» and «Написати» after the first screen; both open the branch picker (without script: #branches).
import Icon from "./Icon.astro";
---
<nav class="bar" aria-label="Швидкий зв'язок" data-bar data-rec="R-001,G-R001,S-R007,M-R001">
  <a class="btn" href="#branches" data-picker><Icon name="phone" />Подзвонити</a>
  <a class="btn btn--quiet" href="#branches" data-picker><Icon name="viber" />Написати</a>
</nav>

<style>
  .bar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: var(--z-bar);
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-xs);
    min-height: var(--bar-h); padding: var(--space-sm) var(--space) calc(var(--space-sm) + env(safe-area-inset-bottom));
    background: var(--color-bg); border-top: 1px solid var(--color-rule);
    transition: transform var(--dur-short) var(--ease-out);
  }
  .bar .btn--quiet { background: var(--color-bg); }
  :global(.js) .bar:not(.is-shown) { transform: translateY(110%); }
  @media (min-width: 48rem) { .bar { display: none; } }
  @media (prefers-reduced-motion: reduce) { .bar { transition: none; } }
</style>
